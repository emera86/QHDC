---
import type { CollectionEntry } from 'astro:content';
import { RECIPE_CATEGORIES } from '../data/taxonomy';
import RecipeCard from './RecipeCard.astro';

interface Props {
  recipes: CollectionEntry<'recipes'>[];
  heading: string;
}

const { recipes, heading } = Astro.props;
const categories = RECIPE_CATEGORIES;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="recipe-section" aria-labelledby="collection-heading">
  <div class="section-heading">
    <div><p class="eyebrow">EL RECETARIO</p><h2 id="collection-heading">{heading}</h2></div>
    <a class="text-link" href={`${base}/indice/`}>Índice de recetas <span aria-hidden="true">↗</span></a>
  </div>
  <div class="recipe-tools">
    <label class="search-field"><span class="sr-only">Buscar recetas</span><span aria-hidden="true">⌕</span><input id="recipe-search" type="search" placeholder="Título, autor, categoría o ingrediente" autocomplete="off" /></label>
    <label class="category-field"><span class="sr-only">Filtrar por categoría</span><select id="category-filter"><option value="">Todas las categorías</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
    <span class="result-count" id="result-count" aria-live="polite">{recipes.length} recetas de muestra</span>
  </div>
  <div class="recipe-grid" id="recipe-grid">
    {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
  </div>
  <p class="empty-state" id="empty-state" hidden>No encontramos recetas con esos criterios. Prueba otra búsqueda.</p>
</section>

<script>
  const search = document.querySelector<HTMLInputElement>('#recipe-search');
  const category = document.querySelector<HTMLSelectElement>('#category-filter');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-recipe-card]')];
  const count = document.querySelector<HTMLElement>('#result-count');
  const empty = document.querySelector<HTMLElement>('#empty-state');
  const fold = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es');

  function filterRecipes() {
    const query = fold(search?.value ?? '');
    const selected = category?.value ?? '';
    let visible = 0;
    for (const card of cards) {
      const matchesQuery = fold(card.dataset.search ?? '').includes(query);
      const matchesCategory = !selected || (card.dataset.categories ?? '').split('|').includes(selected);
      const show = matchesQuery && matchesCategory;
      card.hidden = !show;
      if (show) visible++;
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'receta' : 'recetas'} de muestra`;
    if (empty) empty.hidden = visible > 0;
  }

  search?.addEventListener('input', filterRecipes);
  category?.addEventListener('change', filterRecipes);
</script>
