---
import type { CollectionEntry } from 'astro:content';
import { slugifyTag } from '../data/taxonomy';

interface Props { recipe: CollectionEntry<'recipes'>; }
const { recipe } = Astro.props;
const { title, author, categories, tags, summary, images } = recipe.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/recetas/${recipe.id}/`;
const image = images[0];
const imageSrc = image?.src.startsWith('/') ? `${base}${image.src}` : image?.src;
---

<article class="recipe-card" data-recipe-card data-title={title} data-author={author ?? ''} data-categories={categories.join('|')} data-search={`${title} ${author ?? ''} ${summary} ${categories.join(' ')} ${tags.join(' ')} ${recipe.body}`}>
  <a class="card-image" href={href} aria-label={`Ver receta: ${title}`}>
    {image && imageSrc ? <img src={imageSrc} alt={image.alt} loading="lazy" /> : <span class="image-placeholder" aria-hidden="true">✳</span>}
    <span class="demo-chip">Receta de muestra</span>
  </a>
  <div class="card-copy">
    <div class="card-categories">{categories.map((category) => <span>{category}</span>)}</div>
    {tags.length > 0 && <div class="card-tags" aria-label="Etiquetas temáticas">{tags.map((tag) => <a href={`${base}/etiquetas/${slugifyTag(tag)}/`}>{tag}</a>)}</div>}
    <h3><a href={href}>{title}</a></h3>
    {author && <p class="card-author">De {author}</p>}
    <p class="card-summary">{summary}</p>
    <a class="text-link" href={href}>Ver receta <span aria-hidden="true">↗</span></a>
  </div>
</article>
