---
import { getCollection } from 'astro:content';
import RecipeCollection from '../../components/RecipeCollection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugifyTag, TAG_DESCRIPTIONS } from '../../data/taxonomy';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const tags = new Map<string, string>();
  for (const recipe of recipes) {
    for (const tag of recipe.data.tags) tags.set(slugifyTag(tag), tag);
  }
  return [...tags].map(([slug, tag]) => ({ params: { slug }, props: { tag } }));
}

const { tag } = Astro.props;
const allRecipes = await getCollection('recipes');
const recipes = allRecipes.filter((recipe) => recipe.data.tags.includes(tag));
const description = TAG_DESCRIPTIONS[tag];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={tag} description={description ?? `Índice de recetas con la etiqueta ${tag}.`}>
  <section class="page-intro tag-page-intro">
    <p class="eyebrow">ÍNDICE TEMÁTICO</p>
    <h1>{tag}</h1>
    {description && <p>{description}</p>}
    <p class="tag-count">{recipes.length} {recipes.length === 1 ? 'receta asociada' : 'recetas asociadas'}</p>
    <a class="text-link" href={`${base}/indice/`}>← Volver al índice de recetas</a>
  </section>
  <RecipeCollection recipes={recipes} heading="Recetas de esta temática" />
</BaseLayout>
