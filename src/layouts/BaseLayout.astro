---
import '../styles/global.css';
import { RECIPE_CATEGORIES } from '../data/taxonomy';
import { STORY_PAGES } from '../data/storyPages';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Un recetario familiar de muestra, sencillo y hecho para compartir.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const index = `${base}/indice/`;
const categoryLinks = RECIPE_CATEGORIES.map((category) => ({
  label: category,
  href: `${index}?categoria=${encodeURIComponent(category)}`,
}));
const storyPageLinks = STORY_PAGES.map((page) => ({
  label: page.title,
  href: `${base}/nuestra-historia/${page.slug}/`,
}));
const storyIndex = `${base}/nuestra-historia/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffdf2" />
    <title>{title} · ¿Qué hay de comer?</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label="¿Qué hay de comer?, portada">
        <span class="brand-mark" aria-hidden="true">&#x2733;&#xFE0E;</span>
        <span><strong>¿Qué hay de comer?</strong><small>El rincón de recetas familiares</small></span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
        <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span></span>
        <span class="nav-toggle-label">Menú</span>
      </button>
      <nav class="primary-nav" id="primary-navigation" aria-label="Navegación principal">
        <a href={home} aria-current={Astro.url.pathname === home ? 'page' : undefined}>Portada</a>
        <div class="index-nav-item">
          <a href={index} aria-current={Astro.url.pathname === index ? 'page' : undefined}>Índice de recetas</a>
          <details class="category-menu">
            <summary><span class="sr-only">Mostrar categorías</span></summary>
            <ul class="category-submenu">
              {categoryLinks.map((category) => <li><a href={category.href}>{category.label}</a></li>)}
            </ul>
          </details>
        </div>
        <div class="story-nav-item">
          <a href={storyIndex} aria-current={Astro.url.pathname === storyIndex ? 'page' : undefined}>Nuestra historia</a>
          <details class="story-menu">
            <summary><span class="sr-only">Mostrar subartículos de Nuestra historia</span></summary>
            <ul class="story-submenu">
              {storyPageLinks.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
            </ul>
          </details>
        </div>
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer">
      <a class="brand brand-small" href={home}><span class="brand-mark" aria-hidden="true">&#x2733;&#xFE0E;</span><span><strong>¿Qué hay de comer?</strong><small>Un prototipo con recetas ficticias</small></span></a>
      <p>Recetas y fotografías de muestra, guardadas en este proyecto y ajenas a la exportación de Blogger.</p>
    </footer>
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuToggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const primaryNavigation = header?.querySelector<HTMLElement>('.primary-nav');
  const storyMenu = header?.querySelector<HTMLDetailsElement>('.story-menu');
  const categoryMenu = header?.querySelector<HTMLDetailsElement>('.category-menu');

  function closeNavigation() {
    if (!header || !menuToggle || !primaryNavigation) return;
    header.classList.remove('nav-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Abrir navegación');
    if (storyMenu) storyMenu.open = false;
    if (categoryMenu) categoryMenu.open = false;
  }

  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    if (!header || !primaryNavigation) return;
    header.classList.toggle('nav-open', !isOpen);
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Abrir navegación' : 'Cerrar navegación');
  });

  header?.querySelectorAll<HTMLAnchorElement>('.primary-nav a').forEach((link) => {
    link.addEventListener('click', () => closeNavigation());
  });
  header?.querySelector<HTMLAnchorElement>('.brand')?.addEventListener('click', () => closeNavigation());

  document.addEventListener('click', (event) => {
    if (storyMenu && !storyMenu.contains(event.target as Node)) storyMenu.open = false;
    if (categoryMenu && !categoryMenu.contains(event.target as Node)) categoryMenu.open = false;
    if (header && !header.contains(event.target as Node)) closeNavigation();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !header) return;
    if (categoryMenu?.open) {
      categoryMenu.open = false;
      categoryMenu.querySelector('summary')?.focus();
    } else if (storyMenu?.open) {
      storyMenu.open = false;
      storyMenu.querySelector('summary')?.focus();
    } else if (menuToggle?.getAttribute('aria-expanded') === 'true') {
      closeNavigation();
      menuToggle.focus();
    }
  });

  const compactNavigation = window.matchMedia('(max-width: 700px)');
  const responsiveText = [
    header?.querySelector<HTMLElement>('.brand small'),
    header?.querySelector<HTMLElement>('.index-nav-item > a'),
    header?.querySelector<HTMLElement>('.story-nav-item > a'),
  ].filter((element): element is HTMLElement => element !== null && element !== undefined);

  function textWraps(element: HTMLElement) {
    const range = document.createRange();
    range.selectNodeContents(element);
    return range.getClientRects().length > 1 || element.scrollWidth > element.clientWidth + 1;
  }

  function updateResponsiveNavigation() {
    if (!header) return;
    const wasCompact = header.classList.contains('nav-compact');
    if (wasCompact && !compactNavigation.matches) header.classList.remove('nav-compact');

    const shouldBeCompact = compactNavigation.matches || responsiveText.some(textWraps);
    header.classList.toggle('nav-compact', shouldBeCompact);
    if (wasCompact !== shouldBeCompact) closeNavigation();
  }

  let responsiveFrame = 0;
  function scheduleResponsiveNavigation() {
    cancelAnimationFrame(responsiveFrame);
    responsiveFrame = requestAnimationFrame(updateResponsiveNavigation);
  }

  window.addEventListener('resize', scheduleResponsiveNavigation);
  compactNavigation.addEventListener('change', scheduleResponsiveNavigation);
  document.fonts?.ready.then(scheduleResponsiveNavigation);
  scheduleResponsiveNavigation();
</script>
